# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MAYA CHECKOUT (SANDBOX MODE — SERVER-SIDE ONLY, NEVER PREFIX WITH VITE_)
# Leave blank until Maya Business Manager Sandbox credentials are provisioned.
MAYA_ENV="sandbox"
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_ALLOWLIST_IPS="13.229.160.234,3.1.199.75"

# AUTOMATIC 1V1 ONLINE MATCHMAKING (CLIENT + DEPLOYMENT)
# Leave blank when running frontend + Express backend on the same host (default: same-origin /ws/matchmaking).
# When frontend is deployed on Vercel and backend is hosted on Railway/Render/Fly.io, set:
#   VITE_MATCHMAKING_WS_URL="wss://your-backend-host/ws/matchmaking"
#   VITE_API_BASE_URL="https://your-backend-host"
VITE_MATCHMAKING_WS_URL=
VITE_API_BASE_URL=

# BACKEND PRODUCTION SETTINGS (Railway / Render / Fly.io — SERVER-SIDE ONLY)
# Comma-separated allowed frontend origins for CORS & WebSocket origin validation
ALLOWED_ORIGINS="https://block-clash-arena.vercel.app"
# Optional path to persistent volume for SQLite DBs (e.g. /data/matchmaking.db, /data/players.db)
MATCHMAKING_DB_PATH=
PLAYERS_DB_PATH=

# PLAYER AUTHENTICATION FEATURE FLAGS (CLIENT)
# Google Sign-In is enabled by default. Keep Phone OTP disabled ("false") until
# Firebase Console Phone Auth is enabled and explicitly approved for activation.
VITE_ENABLE_PHONE_AUTH="false"

